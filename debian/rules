#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

%:
	dh $@ --with dkms
	
override_dh_install:
	dh_install files/* usr/src/pinctrl-upboard-$(DEB_VERSION_UPSTREAM)/
	dh_install acpi/* usr/src/pinctrl-upboard-$(DEB_VERSION_UPSTREAM)/acpi

override_dh_dkms:
	dh_dkms -V $(DEB_VERSION_UPSTREAM)
	
override_dh_installdeb:
	mkdir -p debian/pinctrl-upboard/DEBIAN
	printf '%s\n' '#!/bin/sh' 'modprobe -r upboard-fpga || rmmod upboard-fpga || true' > debian/pinctrl-upboard/DEBIAN/preinst
	chmod +x debian/pinctrl-upboard/DEBIAN/preinst
	dh_installdeb

override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_install:
override_dh_auto_clean:
